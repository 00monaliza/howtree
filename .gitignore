# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ML models (large binaries)
*.pt
*.pth
*.onnx

# Model weights directory — upload manually via scp (see README)
backend/weights/

# Training artifacts
training/dataset/
training/prepared/
training/lightning_logs/

# Detection outputs
result_boxes.jpg
result_centers.jpg
stats.txt
