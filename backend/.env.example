# ============================================================
# Tree Detection Platform — Backend Environment
# Copy to .env and fill values before running
# ============================================================

# --- App ---
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production-use-32-random-bytes

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tree_detection
POSTGRES_USER=tree_app
POSTGRES_PASSWORD=secure_password_here
DATABASE_URL=postgresql+asyncpg://tree_app:secure_password_here@localhost:5432/tree_detection
SYNC_DATABASE_URL=postgresql+psycopg2://tree_app:secure_password_here@localhost:5432/tree_detection

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Imagery providers ---
# Yandex Developer Dashboard: enable "Static API" for this key.
YANDEX_MAPS_API_KEY=
# Optional fallback for satellite imagery.
MAPBOX_TOKEN=

# Primary provider: "esri", "yandex", or "mapbox"
MAP_PROVIDER=esri

# --- Detection ---
TILE_SIZE=400
TILE_OVERLAP=0.2
DETECTION_CONFIDENCE_THRESHOLD=0.4
MAX_BBOX_AREA_KM2=50.0  # safety limit per Celery analysis job

# --- YOLO real-time endpoint ---
# Path is relative to working directory — use an absolute path in production
YOLO_MODEL_PATH=../deepforest_urban_trees_FULL.pt
YOLO_CONFIDENCE=0.25
YOLO_MAX_BBOX_AREA_KM2=5.0  # tighter limit for synchronous requests

# --- Celery ---
CELERY_CONCURRENCY=1
CELERY_MAX_TASKS_PER_CHILD=10

# --- Rate limiting ---
RATE_LIMIT_ANALYZE=10/minute
RATE_LIMIT_GEOJSON=60/minute

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
